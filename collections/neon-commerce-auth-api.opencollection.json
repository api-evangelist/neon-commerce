{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Auth API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neonpay.com/auth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "In order to authenticate a shop user with your game, you need to link the player \"code\" with your internal player account ID. This endpoint does that linking and returns a unique token that can be used to redirect the player back to the shop with an authenticated session.\n"
        }
      ]
    }
  ],
  "bundled": true
}