          "name": "Retrieve a token",
          "request": {
            "name": "Retrieve a token",
            "description": {
              "content": "In order to authenticate a shop user with your game, you need to link the player \"code\" with your internal player account ID. This endpoint does that linking and returns a unique token that can be used to redirect the player back to the shop with an authenticated session.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"<string>\",\n  \"code\": \"<string,null>\",\n  \"accountDisplayName\": \"<string,null>\",\n  \"pricingSheetName\": \"<string>\",\n  \"metadata\": {\n    \"key_0\": 1295.4266881373655,\n    \"key_1\": 4229.000197072342,\n    \"key_2\": 719,\n    \"key_3\": \"string\",\n    \"key_4\": \"string\"\n  },\n  \"fraudMetadata\": {\n    \"customer\": {\n      \"creationTime\": \"<string,null-date-time>\",\n      \"socialSignOnType\": \"<string>\",\n      \"platform\": \"<string>\",\n      \"sessionCount\": \"<integer,null>\",\n      \"levelInApp\": \"<integer,null>\",\n      \"followersInApp\": \"<integer,null>\",\n      \"isOnLatestAppVersion\": \"<boolean,null>\",\n      \"hasLinkedSocialAccount\": \"<boolean,null>\",\n      \"finishedGameSetup\": \"<boolean,null>\",\n      \"isKnownUser\": \"<boolean,null>\"\n    },\n    \"latestLoginIp\": {\n      \"ipAddress\": \"<string,null>\",\n      \"country\": \"<string,null>\",\n      \"city\": \"<string,null>\",\n      \"region\": \"<string,null>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
