{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Payouts API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payouts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all of your Payouts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neonpay.com/payouts"
          },
          "docs": "List all of your Payouts"
        }
      ]
    }
  ],
  "bundled": true
}