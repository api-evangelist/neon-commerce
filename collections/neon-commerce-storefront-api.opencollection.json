        {
          "info": {
            "name": "Delete an offer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.neonpay.com/storefront/offer/:sku",
            "params": [
              {
                "name": "sku",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an offer by its SKU."
        },
        {
          "info": {
            "name": "Get an offer group by code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neonpay.com/storefront/offer-group/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an offer group by its code."
        },
        {
          "info": {
            "name": "Update an offer group by code",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.neonpay.com/storefront/offer-group/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an offer group. This replaces the existing offer group with the input data."
        },
        {
          "info": {
            "name": "Delete an offer group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.neonpay.com/storefront/offer-group/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an offer by its code."
        },
        {
          "info": {
            "name": "Get localized pricing by IP address.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neonpay.com/storefront/prices",
            "params": [
              {
                "name": "ip",
                "value": "",
                "type": "query",
                "description": "The IP address of the user"
              }
            ]
          },
          "docs": "Get localized pricing by IP address."
        },
        {
          "info": {
            "name": "Get a storefront theme",
            "type": "http"
