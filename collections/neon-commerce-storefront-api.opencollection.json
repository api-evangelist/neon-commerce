          "info": {
            "name": "Update an offer by SKU",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.neonpay.com/storefront/offer/:sku",
            "params": [
              {
                "name": "sku",
                "value": "",
