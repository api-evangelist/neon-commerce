        },
        {
          "info": {
            "name": "Update the theme for a storefront",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.neonpay.com/storefront/theme",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Programatically update the configuration for a theme"
        },
        {
          "info": {
            "name": "Register a URL to handle events throughout the storefront and checkout flow.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neonpay.com/storefront/callbacks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Learn more about callbacks [here](https://neonpay.readme.io/docs/webhooks-and-callbacks)."
        }
