{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Subscriptions API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cancel a subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neonpay.com/subscriptions/:subscriptionId/cancel",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancel a subscription.\n"
        },
        {
          "info": {
            "name": "Generate a payment method update link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neonpay.com/subscriptions/:subscriptionId/update-payment-method",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a redirect URL where the user can update their subscription's payment method. The URL expires after 1 hour.\n"
        },
        {
          "info": {
            "name": "Returns a subscription's details.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neonpay.com/subscriptions/:subscriptionId",
            "params": [
              {
                "name": "subscriptionId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Can be used to get the status of a particular subscription."
        },
        {
          "info": {
            "name": "Create a subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.neonpay.com/subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a subscription. Once the subscription is created, redirect the user to the `returnUrl`.\n"
        }
      ]
    }
  ],
  "bundled": true
}