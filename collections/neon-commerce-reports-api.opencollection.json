{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Reports API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Report details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.neonpay.com/reports/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve Report details"
        }
      ]
    }
  ],
  "bundled": true
}